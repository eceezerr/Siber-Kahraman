--- !u!114 &1243885566
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1243885562}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2a400288c407e4880b0fe245516e4816, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  player: {fileID: 265936432}
  soruMetni: {fileID: 528236951}
  ipucuText: {fileID: 1471696196}
  ipucuPaneli: {fileID: 1805429736}
  anahtarSayaciText: {fileID: 1973138305}
  butonGrubu: {fileID: 1638579826}
  inputGrubu: {fileID: 2145515772}
  cevapInput: {fileID: 1874030931}
  sesKaynagi: {fileID: 1243885567}
  dogruCevapSesi: {fileID: 8300000, guid: a9794b9643c54425d893372813039d3a, type: 3}
  yanlisCevapSesi: {fileID: 8300000, guid: 6c521bf0258ee477f9e2ad5ae9de95b0, type: 3}
  sorular:
  - soruMetni: "\u015Eifrenin \xE7al\u0131nmas\u0131 ve ba\u015Fkas\u0131n\u0131n
      senin mesajlar\u0131n\u0131 okumas\u0131 hangi kural\u0131 bozar?"
    ipucuMetni: "Bilgilerin sadece g\xF6rme yetkisi olan ki\u015Filerde kalmas\u0131
      kural\u0131n\u0131 hat\u0131rla."
    tipi: 1
    dogruCevap: gizlilik
  - soruMetni: "Bilgilerin sadece yetkili ki\u015Filerce (sen ve ailen gibi) g\xF6r\xFClmesine
      ne denir?"
    ipucuMetni: "Ba\u015Fkalar\u0131n\u0131n senin \xF6zel bilgilerine eri\u015Fememesi
      durumuna ne ad verilir?"
    tipi: 1
    dogruCevap: gizlilik
  - soruMetni: "Bir dosyan\u0131n bozulmadan, de\u011Fi\u015Ftirilmeden ilk g\xFCnk\xFC
      gibi durmas\u0131na ne denir?"
    ipucuMetni: "Bilginin tam, do\u011Fru ve orijinal haliyle korunmas\u0131 \xF6zelli\u011Fidir."
    tipi: 1
    dogruCevap: "b\xFCt\xFCnl\xFCk"
  - soruMetni: "Bir hacker\u0131n okulun web sitesindeki notlar\u0131 de\u011Fi\u015Ftirmesi
      bilginin hangi \xF6zelli\u011Fine zarar verir?"
    ipucuMetni: "Bilginin izinsiz de\u011Fi\u015Ftirilmesi veya bozulmas\u0131 hangi
      kurala ayk\u0131r\u0131d\u0131r?"
    tipi: 1
    dogruCevap: "b\xFCt\xFCnl\xFCk"
  - soruMetni: "\u0130nternet kesildi\u011Fi i\xE7in \xF6dev dosyana ula\u015Famaman
      hangi kural\u0131n ihlalidir?"
    ipucuMetni: "Bilgiye ihtiya\xE7 duydu\u011Fun her an sorunsuz ula\u015Fabilme
      \xF6zelli\u011Fini hat\u0131rla."
    tipi: 1
    dogruCevap: "eri\u015Filebilirlik"
  - soruMetni: "\u0130htiyac\u0131m\u0131z oldu\u011Funda bilgiye her an ula\u015Fabilmemize
      ne denir?"
    ipucuMetni: "Sistemin \xE7al\u0131\u015F\u0131r durumda olmas\u0131 ve bilginin
      haz\u0131rda beklemesi \xF6zelli\u011Fidir."
    tipi: 1
    dogruCevap: "eri\u015Filebilirlik"
  toplananAnahtar: 0
  hedefAnahtar: 6
