--- !u!114 &1243885566
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1243885562}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2a400288c407e4880b0fe245516e4816, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  player: {fileID: 265936432}
  soruMetni: {fileID: 528236951}
  ipucuText: {fileID: 1716339913}
  ipucuPaneli: {fileID: 1396205443}
  anahtarSayaciText: {fileID: 1973138305}
  butonGrubu: {fileID: 1638579826}
  inputGrubu: {fileID: 2145515772}
  cevapInput: {fileID: 1874030931}
  sesKaynagi: {fileID: 1243885567}
  dogruCevapSesi: {fileID: 8300000, guid: a9794b9643c54425d893372813039d3a, type: 3}
  yanlisCevapSesi: {fileID: 8300000, guid: 6c521bf0258ee477f9e2ad5ae9de95b0, type: 3}
  sorular:
  - soruMetni: "Can'\u0131n tan\u0131mad\u0131\u011F\u0131 birinden gelen linke t\u0131klamas\u0131
      g\xFCvenli midir?"
    ipucuMetni: "Kayna\u011F\u0131n\u0131 bilmedi\u011Fin dosyalarda bilgisayar\u0131na
      s\u0131zabilecek \"zararl\u0131 yaz\u0131l\u0131mlar\" gizli olabilir."
    tipi: 0
    dogruCevap: riskli
  - soruMetni: "Bilgisayarda aniden \xE7\u0131kan reklamlar neyin belirtisidir?"
    ipucuMetni: "Bilgisayar\u0131n kontrol d\u0131\u015F\u0131 hareket etmesi, arka
      planda \xE7al\u0131\u015Fan istenmeyen bir program\u0131n i\u015Faretidir."
    tipi: 1
    dogruCevap: "vir\xFCs"
  - soruMetni: "Can'\u0131n hesab\u0131ndan ba\u015Fkalar\u0131na mesaj gitmesi hangi
      kural\u0131n ihlalidir?"
    ipucuMetni: "Hesab\u0131n ba\u015Fkalar\u0131 taraf\u0131ndan ele ge\xE7irilmesi,
      senin \xF6zel bilgilerinin korunamad\u0131\u011F\u0131 anlam\u0131na gelir."
    tipi: 1
    dogruCevap: gizlilik
  - soruMetni: "Can bu sorunu \xE7\xF6zmek i\xE7in ilk kime dan\u0131\u015Fmal\u0131d\u0131r?"
    ipucuMetni: "\u0130nternette bir hata yapt\u0131\u011F\u0131nda bunu tek ba\u015F\u0131na
      \xE7\xF6zmek yerine g\xFCvenilir yeti\u015Fkinlerden yard\u0131m almal\u0131s\u0131n."
    tipi: 1
    dogruCevap: aile
  - soruMetni: "Bilgisayar\u0131 korumak i\xE7in hangi yaz\u0131l\u0131m kullan\u0131lmal\u0131d\u0131r?"
    ipucuMetni: "Bilgisayara giren dosyalar\u0131 tarayan ve tehlikeleri temizleyen
      \xF6zel g\xFCvenlik program\u0131n\u0131 hat\u0131rla."
    tipi: 1
    dogruCevap: "antivir\xFCs"
  - soruMetni: "Can bir dahaki sefere \u015F\xFCpheli dosyalar\u0131 ne yapmal\u0131d\u0131r?(silmeli-t\u0131klamal\u0131)"
    ipucuMetni: "Tan\u0131mad\u0131\u011F\u0131n ki\u015Filerin g\xF6nderdi\u011Fi
      her link veya dosya g\xF6r\xFCnd\xFC\u011F\xFC kadar masum olmayabilir."
    tipi: 1
    dogruCevap: silmeli
  toplananAnahtar: 0
  hedefAnahtar: 6
