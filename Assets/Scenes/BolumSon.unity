      m_Calls: []
  m_text: "\"Can, \xE7ok sevdi\u011Fi bir oyunu oynarken tan\u0131mad\u0131\u011F\u0131n
    birinden bir mesaj ald\u0131: 'Hey Can! Senin karakterin \xE7ok zay\u0131f. E\u011Fer
    bu linkteki dosyay\u0131 indirirsen sana en g\xFC\xE7l\xFC k\u0131l\u0131c\u0131
    verebilirim.' Can \xE7ok heyecanland\u0131, linke t\u0131klad\u0131 ve dosyay\u0131
    indirdi. O andan itibaren bilgisayar\u0131 kasmaya ba\u015Flad\u0131, ekran\u0131nda
    garip reklamlar \xE7\u0131kt\u0131 ve arkada\u015Flar\u0131na Can'\u0131n hesab\u0131ndan
    k\xF6t\xFC mesajlar gitmeye ba\u015Flad\u0131.\""
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
