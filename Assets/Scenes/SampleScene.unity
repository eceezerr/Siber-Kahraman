  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2a400288c407e4880b0fe245516e4816, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  player: {fileID: 265936432}
  soruMetni: {fileID: 1802262649}
  ipucuText: {fileID: 597335731}
  ipucuPaneli: {fileID: 2028175791}
  anahtarSayaciText: {fileID: 1613658143}
  butonGrubu: {fileID: 1622803459}
  inputGrubu: {fileID: 760043334}
  cevapInput: {fileID: 1252808417}
  sesKaynagi: {fileID: 1615207773}
  dogruCevapSesi: {fileID: 8300000, guid: a9794b9643c54425d893372813039d3a, type: 3}
  yanlisCevapSesi: {fileID: 8300000, guid: 6c521bf0258ee477f9e2ad5ae9de95b0, type: 3}
  sorular:
  - soruMetni: "Bir web sitesinde \"Tebrikler, iPhone kazand\u0131n\u0131z! Hemen
      telefon numaran\u0131z\u0131 girin\" yaz\u0131s\u0131 nedir?"
    ipucuMetni: "A\u015F\u0131r\u0131 cazip teklifler genellikle ki\u015Fisel bilgilerinizi
      ele ge\xE7irmek i\xE7in kullan\u0131lan tuzaklard\u0131r"
    tipi: 0
    dogruCevap: riskli
  - soruMetni: "\u0130nternette yeni tan\u0131\u015Ft\u0131\u011F\u0131n birine okulunun
      ad\u0131n\u0131 ve adresini s\xF6ylemek nedir?\n"
    ipucuMetni: "Okul ad\u0131 ve adres gibi ki\u015Fisel bilgiler, k\xF6t\xFC niyetli
      ki\u015Filerce fiziksel g\xFCvenli\u011Fini tehdit etmek i\xE7in kullan\u0131labilir."
    tipi: 0
    dogruCevap: riskli
  - soruMetni: "Tan\u0131mad\u0131\u011F\u0131n birinden gelen \"Bedava elmas kazand\u0131n\"
      linkine t\u0131klamak hangisidir?"
    ipucuMetni: "\"Bedava\" vaadiyle g\xF6nderilen linkler genellikle cihaz\u0131na
      vir\xFCs bula\u015Ft\u0131rmak i\xE7in tasarlanm\u0131\u015Ft\u0131r."
    tipi: 0
    dogruCevap: riskli
  - soruMetni: "E-posta kutuna gelen \"Hesab\u0131n \xE7al\u0131nd\u0131, kurtarmak
      i\xE7in buraya \u015Fifreni yaz\" mesaj\u0131 nedir?"
    ipucuMetni: "G\xFCvenilir kurumlar sizden asla e-posta yoluyla \u015Fifrenizi
      istemezler.\n"
    tipi: 0
    dogruCevap: riskli
  - soruMetni: "\u0130nternette kar\u015F\u0131na \xE7\u0131kan \"Bilgisayar\u0131nda
      vir\xFCs var, temizlemek i\xE7in bu dosyay\u0131 indir\" uyar\u0131s\u0131
      nedir?"
    ipucuMetni: "Sahte vir\xFCs uyar\u0131lar\u0131, sizi korkutarak cihaz\u0131n\u0131za
      as\u0131l vir\xFCsl\xFC dosyay\u0131 indirmenizi sa\u011Flamaya \xE7al\u0131\u015F\u0131r."
    tipi: 0
    dogruCevap: riskli
  - soruMetni: "G\xFCvenilir bir kaynaktan (\xF6rne\u011Fin EBA) dosya indirmek nedir?"
    ipucuMetni: "Resmi ve g\xFCvenilir e\u011Fitim platformlar\u0131ndan dosya indirmek,
      dijital g\xFCvenlik a\xE7\u0131s\u0131ndan g\xFCvenli bir eylemdir."
    tipi: 0
    dogruCevap: "g\xFCvenli"
  toplananAnahtar: 0
  hedefAnahtar: 6
