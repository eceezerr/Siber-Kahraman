--- !u!114 &1243885566
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1243885562}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2a400288c407e4880b0fe245516e4816, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  player: {fileID: 265936432}
  soruMetni: {fileID: 528236951}
  ipucuText: {fileID: 419468259}
  ipucuPaneli: {fileID: 1708685248}
  anahtarSayaciText: {fileID: 1973138305}
  butonGrubu: {fileID: 1638579826}
  inputGrubu: {fileID: 2145515772}
  cevapInput: {fileID: 1874030931}
  sesKaynagi: {fileID: 1243885567}
  dogruCevapSesi: {fileID: 8300000, guid: a9794b9643c54425d893372813039d3a, type: 3}
  yanlisCevapSesi: {fileID: 8300000, guid: 6c521bf0258ee477f9e2ad5ae9de95b0, type: 3}
  sorular:
  - soruMetni: "\u015Eifreni belirlerken i\xE7inde sadece do\u011Fum y\u0131l\u0131n
      m\u0131 olmal\u0131, yoksa harf say\u0131 sembol m\xFC?"
    ipucuMetni: "Tahmin edilmesi zor bir \u015Fifre i\xE7in sadece rakam kullanmak
      yetmez; harf ve i\u015Faretler g\xFCvenli\u011Fi art\u0131r\u0131r."
    tipi: 1
    dogruCevap: "harf say\u0131 sembol"
  - soruMetni: "En g\xFC\xE7l\xFC \u015Fifre hangisidir? (123456 / Ah5!697E)"
    ipucuMetni: "G\xFC\xE7l\xFC bir \u015Fifre; ad\u0131n, soyad\u0131n veya s\u0131ral\u0131
      say\u0131lar gibi kolay tahmin edilebilecek bilgiler i\xE7ermemelidir."
    tipi: 1
    dogruCevap: Ah5!697E
  - soruMetni: "Tan\u0131mad\u0131\u011F\u0131n birinden gelen g\xF6r\xFCnt\xFCl\xFC
      arama iste\u011Fine ne yapmal\u0131s\u0131n? (Reddet / Kabul Et)"
    ipucuMetni: "Tan\u0131mad\u0131\u011F\u0131n ki\u015Filerin g\xF6r\xFCnt\xFCl\xFC
      aramalar\u0131 ki\u015Fisel g\xFCvenli\u011Fini tehdit edebilir, bu aramalar\u0131
      reddetmek en g\xFCvenli yoldur."
    tipi: 1
    dogruCevap: reddet
  - soruMetni: "G\xFC\xE7l\xFC bir \u015Fifre en az ka\xE7 karakter olmal\u0131d\u0131r?
      (Say\u0131yla yaz)"
    ipucuMetni: "\u015Eifrenin ne kadar uzun olursa o kadar g\xFCvenli oldu\u011Funu
      hat\u0131rla; d\xFCnyaca kabul edilen en az s\u0131n\u0131r\u0131 d\xFC\u015F\xFCn."
    tipi: 1
    dogruCevap: 8
  - soruMetni: "\u0130nternette \u015F\xFCpheli bir durumla kar\u015F\u0131la\u015Ft\u0131\u011F\u0131nda
      mutlaka kime haber vermelisin?(aile-arkada\u015F)"
    ipucuMetni: "\u0130nternette seni korkutan veya \u015F\xFCphelendiren her \u015Feyi,
      sana en h\u0131zl\u0131 yard\u0131m edebilecek yeti\u015Fkinlerle payla\u015Fmal\u0131s\u0131n."
    tipi: 1
    dogruCevap: aile
  - soruMetni: "Tabletine veya bilgisayar\u0131na izinsiz giri\u015Fleri engellemek
      i\xE7in ne koymal\u0131s\u0131n?"
    ipucuMetni: "Cihaz\u0131n\u0131 ve i\xE7indeki foto\u011Fraflar\u0131n\u0131
      korumak i\xE7in ilk savunma hatt\u0131n olan koruma y\xF6ntemini hat\u0131rla."
    tipi: 1
    dogruCevap: "\u015Fifre"
  toplananAnahtar: 0
  hedefAnahtar: 6
